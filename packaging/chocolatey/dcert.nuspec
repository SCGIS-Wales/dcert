  <metadata>
    <id>dcert</id>
    <version>__VERSION__</version>
    <title>dcert (TLS Certificate Toolkit &amp; MCP Server)</title>
    <authors>SCGIS-Wales</authors>
    <owners>SCGIS-Wales</owners>
    <projectUrl>https://github.com/SCGIS-Wales/dcert</projectUrl>
    <packageSourceUrl>https://github.com/SCGIS-Wales/dcert/tree/main/packaging/chocolatey</packageSourceUrl>
    <projectSourceUrl>https://github.com/SCGIS-Wales/dcert</projectSourceUrl>
    <bugTrackerUrl>https://github.com/SCGIS-Wales/dcert/issues</bugTrackerUrl>
    <docsUrl>https://github.com/SCGIS-Wales/dcert/blob/main/README.md</docsUrl>
